{
  "manifest_version": 3,
  "name": "AuditIQ - Website Analyzer",
  "version": "1.0.0",
  "description": "Instantly audit any website you're visiting",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "48": "icons/icon48.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
